{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "types": ["node"],

    "rootDir": "./",
    "outDir": "./dist",

    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}